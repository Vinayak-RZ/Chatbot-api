{
  "name": "chatbot-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API bridge that drives a ChatGPT-like chatbot via Playwright",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "mock": "tsx scripts/mock-chatbot/server.ts",
    "smoke": "tsx scripts/smoke.ts",
    "login": "tsx scripts/login.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "p-queue": "^8.1.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "playwright": "^1.50.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
