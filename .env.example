# Copy to .env and edit. Never commit .env or session files.

HOST=127.0.0.1
PORT=8787

# Single key OR comma-separated allowlist (1–3). API_KEYS wins if both set.
API_KEY=dev-key-change-me
# API_KEYS=key-a,key-b

# Pages in the persistent browser (1–3). Must be >= number of API keys.
MAX_PAGES=1

RATE_LIMIT_RPM=10
QUEUE_MAX=8
MAX_PROMPT_CHARS=8000

# Launch mode (tests/CI): Playwright opens its own Chromium at this URL.
CHATBOT_URL=http://127.0.0.1:4173
MOCK_PORT=4173

HEADLESS=false

# Operator path: attach to a Chrome/Edge window you already opened. The API
# never launches a browser. Enable remote debugging on
# chrome://inspect/#remote-debugging (Edge: edge://inspect/#remote-debugging),
# click Allow, then set:
# BROWSER_MODE=attach
# CDP_URL=chrome
# CDP_ATTACH_TAB=focused
# Optional: pin a tab by URL (only that origin is eligible; other tabs are not logged).
# CDP_ATTACH_TAB=url
# CHATBOT_URL=https://your-owned-chatbot.example/
# CDP_CONNECT_TIMEOUT_MS=90000
# Keep using the already-bound page (does not scan other tabs for a composer).
# CDP_REUSE_TABS=true

# Tests/CI: leave BROWSER_MODE unset (defaults to launch) and leave CDP_URL empty.
# BROWSER_MODE=launch

USER_DATA_DIR=./data/browser-profile
STORAGE_STATE_PATH=./data/storage-state.json

FIRST_TOKEN_TIMEOUT_MS=8000
GENERATION_TIMEOUT_MS=12000
SUBMIT_ACK_MS=5000
NAVIGATION_TIMEOUT_MS=30000
SUBMIT_STRATEGY=auto

LOG_PROMPTS=false
ARTIFACTS_ON_ERROR=true
